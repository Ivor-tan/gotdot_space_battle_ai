DisplayName = "蜂群航母"
DisplayNameKey = &"CODEX_SHIP_SHP_PLY_CAR_001_DISPLAYNAME"
CenterRingEffectId = &"RING_CAR_CENTER"
RingOneEffectId = &"RING_CAR_R1"
RingTwoEffectId = &"RING_CAR_R2"
CenterRingEffect = "无人机返航后下次攻击 +8% 伤害。"
CenterRingEffectKey = &"CODEX_SHIP_SHP_PLY_CAR_001_CENTERRINGEFFECT"
RingOneEffect = "优先拦截距相邻舰 150 内目标。"
RingTwoEffect = "无人机索敌 +25%、飞速 +15%。"
BranchIds = Array[StringName]([&"ULK_UPG_HIV_SWM_", &"ULK_UPG_HIV_HNT_", &"ULK_UPG_HIV_GRD_"])
BranchOneDescription = "蜂群算法 `ULK_UPG_HIV_SWM_001–003` | 无人机上限 +1。 | 3 架连续攻击同目标后，第 4 次 +70% 伤害。 | 击败普通敌人有 25% 概率部署临时无人机 5 秒，受总上限限制。"
BranchOneDescriptionKey = &"CODEX_SHIP_SHP_PLY_CAR_001_BRANCHONEDESCRIPTION"
BranchTwoDescription = "猎杀标记 `ULK_UPG_HIV_HNT_001–003` | 首命中附加猎杀标记 3 秒。 | 标记目标受无人机伤害 +20%。 | 标记死后立即转向最近标记目标并获 35% 攻速 2 秒。"
BranchTwoDescriptionKey = &"CODEX_SHIP_SHP_PLY_CAR_001_BRANCHTWODESCRIPTION"
BranchThreeDescription = "近防机库 `ULK_UPG_HIV_GRD_001–003` | 优先攻击距航母 150 内敌人。 | 击败 5 近身敌人，航母获 1 层护盾。 | 航母或相邻舰被近身命中时，全机对攻击者 120% 反击，每目标 5 秒一次。"
BranchThreeDescriptionKey = &"CODEX_SHIP_SHP_PLY_CAR_001_BRANCHTHREEDESCRIPTION"

