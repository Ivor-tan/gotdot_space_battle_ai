BranchOneDescription = "前线铁幕 `ULK_UPG_IRN_FRN_001–003` | 位于前侧格位时扇面炮伤害 +20%。 | 前侧相邻舰攻击范围 +10%。 | 前侧每有1艘相邻舰，自身伤害 +5%，最多3层。"
BranchOneDescriptionKey = &"CODEX_SHIP_SHP_PLY_GRD_002_BRANCHONEDESCRIPTION"
BranchTwoDescription = "反击装甲 `ULK_UPG_IRN_CNT_001–003` | 自身失盾时下发扇面炮 +70%伤害。 | 该炮命中3敌人获1层护盾，8秒内最多1层。 | 反击触发后，140内普通敌人击退70。"
BranchTwoDescriptionKey = &"CODEX_SHIP_SHP_PLY_GRD_002_BRANCHTWODESCRIPTION"
BranchThreeDescription = "掩护扇面 `ULK_UPG_IRN_COV_001–003` | 扇面内敌人移速 -12%。 | 扇面命中精英时，其对非铁幕目标伤害 -15% 2秒。 | 连续4次扇面命中后，下次角度 +35°、射程 +20%，每6秒一次。"
BranchThreeDescriptionKey = &"CODEX_SHIP_SHP_PLY_GRD_002_BRANCHTHREEDESCRIPTION"

