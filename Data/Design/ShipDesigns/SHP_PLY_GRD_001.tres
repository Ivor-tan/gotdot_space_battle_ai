BranchOneDescription = "近防矩阵 `ULK_UPG_PRM_GUA_001–003` | 180 内敌人受伤 +25%。 | 击败 6 近身敌人获 1 层个人护盾。 | 自身或相邻舰受近身命中后，下发伤害 +80%，每 4 秒一次。"
BranchOneDescriptionKey = &"CODEX_SHIP_SHP_PLY_GRD_001_BRANCHONEDESCRIPTION"
BranchTwoDescription = "折光炮幕 `ULK_UPG_PRM_RAY_001–003` | 获盾后下一发分裂两束，各 60% 伤害。 | 失盾释放脉冲，使 140 内敌人减速 30% 1 秒。 | 每层个人护盾对精英/Boss伤害 +8%，受护盾上限限制。"
BranchTwoDescriptionKey = &"CODEX_SHIP_SHP_PLY_GRD_001_BRANCHTWODESCRIPTION"
BranchThreeDescription = "定点壁垒 `ULK_UPG_PRM_BST_001–003` | 2 秒未换位时，攻击范围 +15%。 | 定点时相邻舰攻击范围 +10%。 | 定点 6 秒展开壁垒区 3 秒，普通敌人减速 45%。"
BranchThreeDescriptionKey = &"CODEX_SHIP_SHP_PLY_GRD_001_BRANCHTHREEDESCRIPTION"

