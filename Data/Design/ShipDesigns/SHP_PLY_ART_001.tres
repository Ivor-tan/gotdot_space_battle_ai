BranchOneDescription = "炉心余烬 `ULK_UPG_SOL_FUR_001–003` | 爆炸附加 3 秒灼烧，每秒 20% 基础伤害。 | 灼烧目标再受爆炸时向最近 2 敌人溅射 25%。 | 灼烧 3 层爆裂，80% 范围伤害；同目标 5 秒一次。"
BranchOneDescriptionKey = &"CODEX_SHIP_SHP_PLY_ART_001_BRANCHONEDESCRIPTION"
BranchTwoDescription = "日斑抛射 `ULK_UPG_SOL_FLR_001–003` | 爆炸边缘留下 2 枚日斑，0.6 秒后各 30% 伤害。 | 日斑命中灼烧目标时减速 20% 1.5 秒。 | 每 6 秒下次爆炸生成 5 日斑，单枚伤害降为 22%。"
BranchTwoDescriptionKey = &"CODEX_SHIP_SHP_PLY_ART_001_BRANCHTWODESCRIPTION"
BranchThreeDescription = "阵地火控 `ULK_UPG_SOL_SIE_001–003` | 距目标 380 外伤害 +20%。 | 超远命中减速 25% 2 秒。 | 连续 3 次攻击同一区域后，下次半径 +45%、伤害 +40%。"
BranchThreeDescriptionKey = &"CODEX_SHIP_SHP_PLY_ART_001_BRANCHTHREEDESCRIPTION"

